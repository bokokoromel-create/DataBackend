generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid())
  supabaseId      String            @unique
  prenom          String
  nom             String
  email           String            @unique
  ville           String
  arrondissement  String?
  telephone       String?
  createdAt       DateTime          @default(now())
  questionnaire   Questionnaire?
  sondageReponses SondageReponse[]
}

model Questionnaire {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  reponses  Json
  createdAt DateTime @default(now())
}

model AdminUser {
  id              String   @id @default(uuid())
  supabaseId      String   @unique
  nomComplet      String
  email           String   @unique
  nomOrganisation String
  fonctionPoste   String
  secteurInteret  String
  createdAt       DateTime @default(now())
}

model Evenement {
  id          String   @id @default(uuid())
  titre       String
  debutAt     DateTime
  lieu        String?
  description String?
  createdAt   DateTime @default(now())
}

model Sondage {
  id        String           @id @default(uuid())
  question  String
  options   String[]
  actif     Boolean          @default(true)
  createdAt DateTime         @default(now())
  reponses  SondageReponse[]
}

model SondageReponse {
  id        String   @id @default(uuid())
  sondageId String
  userId    String
  option    String
  createdAt DateTime @default(now())
  sondage   Sondage  @relation(fields: [sondageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sondageId, userId])
}