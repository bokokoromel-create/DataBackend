generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid())
  supabaseId              String                   @unique
  prenom                  String
  nom                     String
  email                   String                   @unique
  ville                   String
  arrondissement          String?
  telephone               String?
  age                     Int?
  sexe                    String?
  lastActiveAt            DateTime?
  createdAt               DateTime                 @default(now())
  questionnaire           Questionnaire?
  sondageReponses         SondageReponse[]
  diplome                 Diplome?
  gamification            UserGamification?
  publicationReactions    PublicationReaction[]
  publicationCommentaires PublicationCommentaire[]
  /**
   * Zone la plus précise résolue depuis `ville`/`arrondissement` (carte admin).
   */
  zoneAdministrativeId    String?
  zoneAdministrative      ZoneAdministrative?      @relation(fields: [zoneAdministrativeId], references: [id])
}

enum TypeZoneAdministrative {
  SECTEUR
  QUARTIER
}

/**
 * Référentiel géographique hiérarchique (ville → secteur → quartier), utilisé
 * pour la carte admin. Table auto-référencée et réutilisable plus tard par
 * d'autres modèles (publications, matching) via une simple FK supplémentaire.
 */
model ZoneAdministrative {
  id           String                 @id @default(uuid())
  type         TypeZoneAdministrative
  nom          String
  ville        String
  parentId     String?
  parent       ZoneAdministrative?    @relation("HierarchieZone", fields: [parentId], references: [id])
  enfants      ZoneAdministrative[]   @relation("HierarchieZone")
  /**
   * Coordonnée approximative de la zone (centroïde), pas une position individuelle.
   */
  latitude     Float?
  longitude    Float?
  actif        Boolean                @default(true)
  createdAt    DateTime               @default(now())
  utilisateurs User[]

  @@unique([ville, type, nom])
  @@index([parentId])
  @@index([ville, type])
}

model Diplome {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  uploadedAt  DateTime @default(now())
}

model Questionnaire {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  reponses  Json
  createdAt DateTime @default(now())
}

model AdminUser {
  id              String   @id @default(uuid())
  supabaseId      String   @unique
  nomComplet      String
  email           String   @unique
  nomOrganisation String
  fonctionPoste   String
  secteurInteret  String
  createdAt       DateTime @default(now())
}

model Evenement {
  id           String                   @id @default(uuid())
  titre        String
  debutAt      DateTime
  lieu         String?
  description  String?
  imageUrl     String?
  categorie    String?
  createdAt    DateTime                 @default(now())
  reactions    PublicationReaction[]
  commentaires PublicationCommentaire[]
}

model Sondage {
  id        String           @id @default(uuid())
  question  String
  options   String[]
  type      String           @default("consultation")
  actif     Boolean          @default(true)
  createdAt DateTime         @default(now())
  reponses  SondageReponse[]
}

model SondageReponse {
  id        String   @id @default(uuid())
  sondageId String
  userId    String
  option    String
  createdAt DateTime @default(now())
  sondage   Sondage  @relation(fields: [sondageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sondageId, userId])
}

model PublicationReaction {
  id            String    @id @default(uuid())
  publicationId String
  userId        String
  type          String
  createdAt     DateTime  @default(now())
  publication   Evenement @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publicationId, userId])
}

model PublicationCommentaire {
  id            String    @id @default(uuid())
  publicationId String
  userId        String
  texte         String
  createdAt     DateTime  @default(now())
  publication   Evenement @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Opportunite {
  id          String    @id @default(uuid())
  type        String
  titre       String
  description String?
  ville       String?
  echeanceAt  DateTime?
  lien        String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
}

model UserGamification {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationsConsultees  String[] @default([])
  consultationsCompletees Int      @default(0)
  membresInvites          Int      @default(0)
  updatedAt               DateTime @updatedAt
}
