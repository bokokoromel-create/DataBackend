## Backend DataHorizon (example)
##
## Copy this file to `.env` and replace values.
## Never commit real secrets.

# Postgres (Supabase)
# Pooler (recommended for runtime with Prisma driver adapter)
# Astuce docker run --env-file : si P1013 « scheme not recognized », évite les guillemets ou laisse une seule ligne sans espaces autour du =
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD_ENCODED>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct/session (recommended for Prisma CLI / migrations)
DIRECT_URL=postgresql://postgres.<project-ref>:<PASSWORD_ENCODED>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project
SUPABASE_URL="https://<project-ref>.supabase.co"

# Backend-only secret (Service Role key)
SUPABASE_SERVICE_ROLE_KEY="<SUPABASE_SERVICE_ROLE_KEY>"

# Server config
PORT=4000
# Origine du frontend : scheme + host (+ port si besoin), SANS chemin (pas de /onboarding).
# Sinon le navigateur bloque les appels (CORS). FRONTEND_URL est aussi accepté par le backend.
CORS_ORIGIN=https://datahorizon-neon.vercel.app
JSON_BODY_LIMIT=1mb
